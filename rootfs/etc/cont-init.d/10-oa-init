#!/command/with-contenv bash
# Open Archiver AIO - first-boot and every-boot initialisation.
# Creates folders, generates and persists secrets, initialises/hardens PostgreSQL,
# writes Valkey's config, prepares Meilisearch upgrades and writes the runtime env file
# that every service sources.
set -euo pipefail

log() { echo "[oa-init] $*"; }

CONFIG=/config
DATA="${STORAGE_LOCAL_ROOT_PATH:-/data}"
KEYS="$CONFIG/keys"
PGDATA="$CONFIG/postgres"
PGBIN=/usr/libexec/postgresql17
VALKEY_DIR="$CONFIG/valkey"
MEILI_DIR="$CONFIG/meilisearch"
MEILI_DB="$MEILI_DIR/data.ms"
LOGS="$CONFIG/logs"
RUNTIME_ENV="$CONFIG/.runtime-env"

log "Open Archiver AIO ${OA_AIO_VERSION:-unknown} starting."

mkdir -p "$KEYS" "$PGDATA" "$VALKEY_DIR" "$MEILI_DIR/dumps" "$MEILI_DIR/snapshots" "$LOGS" "$DATA" /run/postgresql /run/oa
chmod 700 "$KEYS"

# --- Secrets: environment override wins on first boot, then the persisted file is the source of truth ---
rand_alnum() { tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$1" || true; }
rand_hex()   { od -An -tx1 -N"$1" /dev/urandom | tr -d ' \n'; }

load_or_create() {
    # $1 file, $2 generator command, $3 optional override value
    local file="$KEYS/$1" val
    if [ -s "$file" ]; then
        val="$(tr -d '\r\n' < "$file")"
    elif [ -n "${3:-}" ]; then
        val="$3"
        printf '%s' "$val" > "$file"
    else
        val="$($2)"
        printf '%s' "$val" > "$file"
    fi
    chmod 600 "$file"
    printf '%s' "$val"
}

gen_alnum48() { rand_alnum 48; }
gen_alnum32() { rand_alnum 32; }
gen_hex32()   { rand_hex 32; }

JWT_SECRET="$(load_or_create jwt.secret gen_alnum48 "${JWT_SECRET:-}")"
ENCRYPTION_KEY="$(load_or_create encryption.key gen_hex32 "${ENCRYPTION_KEY:-}")"
MEILI_MASTER_KEY="$(load_or_create meili.key gen_alnum48 "${MEILI_MASTER_KEY:-}")"
PG_PASSWORD="$(load_or_create pg.password gen_alnum32 "")"
PG_SUPER_PASSWORD="$(load_or_create pg-super.password gen_alnum32 "")"
REDIS_PASSWORD="$(load_or_create valkey.password gen_alnum32 "")"

# Storage encryption: once a key exists it is always used, because archived files depend on it.
STORAGE_ENCRYPTION_KEY_VALUE=""
if [ -s "$KEYS/storage-encryption.key" ] || [ "${STORAGE_ENCRYPTION:-true}" = "true" ]; then
    STORAGE_ENCRYPTION_KEY_VALUE="$(load_or_create storage-encryption.key gen_hex32 "${STORAGE_ENCRYPTION_KEY:-}")"
    log "Storage encryption is ON. Back up $KEYS - without storage-encryption.key the archive cannot be read."
else
    log "Storage encryption is OFF (STORAGE_ENCRYPTION=false and no existing key)."
fi

# --- Public URL used by the frontend (ORIGIN) and backend (CORS) ---
APP_URL="${APP_URL:-}"
APP_URL="${APP_URL%/}"
if [ -z "$APP_URL" ] || [[ "$APP_URL" == *YOUR-UNRAID-IP* ]]; then
    log "WARNING: APP_URL is not set. Set it to the exact address you open in the browser, e.g. http://192.168.1.10:3000"
    APP_URL="http://localhost:${PORT_FRONTEND:-3000}"
fi
ORIGIN="${ORIGIN:-$APP_URL}"

TIKA_URL_VALUE=""
if [ "${TIKA_ENABLED:-true}" = "true" ]; then
    TIKA_URL_VALUE="http://127.0.0.1:9998"
fi

# --- Runtime environment shared by all services ---
{
    echo "# Generated by 10-oa-init on every boot. Do not edit; change the container variables instead."
    printf 'export %s=%q\n' \
        DATABASE_URL "postgresql://openarchiver:${PG_PASSWORD}@127.0.0.1:5432/open_archive" \
        MEILI_HOST "http://127.0.0.1:7700" \
        MEILI_MASTER_KEY "$MEILI_MASTER_KEY" \
        REDIS_HOST "127.0.0.1" \
        REDIS_PORT "6379" \
        REDIS_PASSWORD "$REDIS_PASSWORD" \
        REDIS_TLS_ENABLED "false" \
        JWT_SECRET "$JWT_SECRET" \
        ENCRYPTION_KEY "$ENCRYPTION_KEY" \
        APP_URL "$APP_URL" \
        ORIGIN "$ORIGIN" \
        STORAGE_TYPE "${STORAGE_TYPE:-local}" \
        STORAGE_LOCAL_ROOT_PATH "$DATA"
    if [ -n "$STORAGE_ENCRYPTION_KEY_VALUE" ]; then
        printf 'export %s=%q\n' STORAGE_ENCRYPTION_KEY "$STORAGE_ENCRYPTION_KEY_VALUE"
    else
        echo "unset STORAGE_ENCRYPTION_KEY"
    fi
    if [ -n "$TIKA_URL_VALUE" ]; then
        printf 'export %s=%q\n' TIKA_URL "$TIKA_URL_VALUE"
    else
        echo "unset TIKA_URL"
    fi
} > "$RUNTIME_ENV"
chmod 600 "$RUNTIME_ENV"

# --- Ownership (scoped, no recursive walk of the archive) ---
chown postgres:postgres /run/postgresql
if [ "$(stat -c '%U' "$PGDATA")" != "postgres" ]; then
    chown -R postgres:postgres "$PGDATA"
fi
chmod 700 "$PGDATA"
if [ "$(stat -c '%U' "$VALKEY_DIR")" != "valkey" ]; then
    chown -R valkey:valkey "$VALKEY_DIR"
fi

# --- Valkey config (password kept out of the process list) ---
cat > "$VALKEY_DIR/valkey.conf" <<EOF
# Managed by open-archiver-aio. Loopback only; BullMQ requires noeviction.
bind 127.0.0.1
port 6379
protected-mode yes
requirepass ${REDIS_PASSWORD}
dir ${VALKEY_DIR}
appendonly yes
appendfsync everysec
save 900 1 300 10
maxmemory-policy noeviction
EOF
chown valkey:valkey "$VALKEY_DIR/valkey.conf"
chmod 600 "$VALKEY_DIR/valkey.conf"

# --- PostgreSQL 17 ---
PG_LOG="$LOGS/postgres-init.log"
if [ ! -f "$PGDATA/PG_VERSION" ]; then
    log "Initialising PostgreSQL 17 cluster (scram-sha-256)..."
    find "$PGDATA" -mindepth 1 -delete
    PWFILE=/run/oa/.pgpass_init
    printf '%s' "$PG_SUPER_PASSWORD" > "$PWFILE"
    chown postgres:postgres "$PWFILE"
    chmod 600 "$PWFILE"
    su-exec postgres "$PGBIN/initdb" -D "$PGDATA" --username=postgres --encoding=UTF8 --no-locale \
        --auth-local=scram-sha-256 --auth-host=scram-sha-256 --pwfile="$PWFILE"
    rm -f "$PWFILE"
elif [ "$(cat "$PGDATA/PG_VERSION")" != "17" ]; then
    log "ERROR: $PGDATA holds a PostgreSQL $(cat "$PGDATA/PG_VERSION") cluster; this image runs PostgreSQL 17."
    exit 1
fi

cat > "$PGDATA/pg_hba.conf" <<'EOF'
# Managed by open-archiver-aio. Password auth only, loopback only.
local   all             all                                     scram-sha-256
host    all             all             127.0.0.1/32            scram-sha-256
host    all             all             ::1/128                 scram-sha-256
EOF
chown postgres:postgres "$PGDATA/pg_hba.conf"
chmod 600 "$PGDATA/pg_hba.conf"

cat > "$PGDATA/postgresql.auto.aio.conf" <<'EOF'
# Managed by open-archiver-aio.
listen_addresses = '127.0.0.1'
unix_socket_directories = '/run/postgresql'
password_encryption = scram-sha-256
logging_collector = off
EOF
chown postgres:postgres "$PGDATA/postgresql.auto.aio.conf"
if ! grep -q "^include_if_exists = 'postgresql.auto.aio.conf'" "$PGDATA/postgresql.conf"; then
    echo "include_if_exists = 'postgresql.auto.aio.conf'" >> "$PGDATA/postgresql.conf"
fi

log "Provisioning database role and database..."
su-exec postgres "$PGBIN/pg_ctl" -D "$PGDATA" -l "$PG_LOG" -w -t 120 start >/dev/null
export PGPASSWORD="$PG_SUPER_PASSWORD"
PSQL=(psql -h 127.0.0.1 -U postgres -d postgres -v ON_ERROR_STOP=1 -tAq)

if ! "${PSQL[@]}" -c "SELECT 1 FROM pg_roles WHERE rolname='openarchiver'" | grep -q 1; then
    "${PSQL[@]}" -c "CREATE ROLE openarchiver LOGIN PASSWORD '${PG_PASSWORD}'"
fi
"${PSQL[@]}" -c "ALTER ROLE openarchiver WITH LOGIN PASSWORD '${PG_PASSWORD}'"
if ! "${PSQL[@]}" -c "SELECT 1 FROM pg_database WHERE datname='open_archive'" | grep -q 1; then
    "${PSQL[@]}" -c "CREATE DATABASE open_archive OWNER openarchiver"
fi
unset PGPASSWORD
su-exec postgres "$PGBIN/pg_ctl" -D "$PGDATA" -m fast -w stop >/dev/null

# Keep the init log from growing forever
if [ -f "$PG_LOG" ] && [ "$(stat -c%s "$PG_LOG")" -gt 10485760 ]; then
    tail -n 1000 "$PG_LOG" > "$PG_LOG.tmp" && mv "$PG_LOG.tmp" "$PG_LOG"
fi

# --- Meilisearch version change handling ---
# A Meilisearch database only opens with the version that wrote it. When the image ships a newer
# Meilisearch, either migrate in place (dumpless, after a backup copy) or start an empty index
# that Open Archiver rebuilds from the archive (Admin > Index > Full rebuild).
rm -f /run/oa/meili-upgrade
MEILI_BIN_VERSION="$(meilisearch --version | awk '{print $NF}')"
if [ -f "$MEILI_DB/VERSION" ]; then
    MEILI_DB_VERSION="$(tr -d '\r\n' < "$MEILI_DB/VERSION")"
    if [ "$MEILI_DB_VERSION" != "$MEILI_BIN_VERSION" ]; then
        log "Meilisearch index was written by $MEILI_DB_VERSION, image ships $MEILI_BIN_VERSION."
        case "${MEILI_UPGRADE_MODE:-dumpless}" in
            rebuild)
                mv "$MEILI_DB" "$MEILI_DIR/data.ms.old-$MEILI_DB_VERSION"
                log "Moved the old index aside. Open Admin > Index > Full rebuild once the app is up."
                ;;
            *)
                if [ "${MEILI_UPGRADE_BACKUP:-true}" = "true" ]; then
                    rm -rf "$MEILI_DIR"/data.ms.backup-*
                    log "Backing up the index to data.ms.backup-$MEILI_DB_VERSION before upgrading..."
                    cp -a "$MEILI_DB" "$MEILI_DIR/data.ms.backup-$MEILI_DB_VERSION"
                fi
                touch /run/oa/meili-upgrade
                log "Meilisearch will run a dumpless upgrade on this start."
                ;;
        esac
    fi
fi

log "Init complete."
