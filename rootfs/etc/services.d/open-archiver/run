#!/command/with-contenv bash
# shellcheck disable=SC1091
. /config/.runtime-env
cd /app || exit 1

wait_for() {
    local name="$1"; shift
    local n=0
    until "$@" >/dev/null 2>&1; do
        n=$((n + 1))
        if [ $((n % 15)) -eq 0 ]; then echo "[open-archiver] Still waiting for $name..."; fi
        sleep 2
    done
}

wait_for "PostgreSQL" /usr/libexec/postgresql17/pg_isready -h 127.0.0.1 -p 5432
wait_for "Valkey" env REDISCLI_AUTH="$REDIS_PASSWORD" valkey-cli -h 127.0.0.1 ping
wait_for "Meilisearch" curl -fsS http://127.0.0.1:7700/health

echo "[open-archiver] Running database migrations..."
if ! pnpm db:migrate; then
    echo "[open-archiver] Migrations failed; retrying in 10s."
    sleep 10
    exit 1
fi

echo "[open-archiver] Starting Open Archiver ${OA_AIO_VERSION:-} (web UI on port ${PORT_FRONTEND:-3000})."
exec pnpm docker-start:oss
