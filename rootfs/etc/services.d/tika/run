#!/command/with-contenv bash
if [ "${TIKA_ENABLED:-true}" != "true" ]; then
    echo "[tika] Disabled (TIKA_ENABLED=false); attachments use the built-in extractors."
    exec sleep infinity
fi

# Tika 4 resolves plugins/ relative to the working directory
cd /opt/tika-server || exit 1
# shellcheck disable=SC2086
exec su-exec nobody java ${TIKA_JAVA_OPTS:--Xmx1g} -Djava.io.tmpdir=/tmp \
    -cp "/opt/tika-server/tika-server.jar:/opt/tika-server/lib/*" \
    org.apache.tika.server.core.TikaServerCli -h 127.0.0.1 -p 9998 2>&1
